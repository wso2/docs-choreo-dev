#!/usr/bin/env bash

# Variables
TARGET_BRANCH=latest-master-release
REMOTE_NAME=upstream

# source shflags
GITCCP_DIR=$(dirname "$0")
# shellcheck source=/dev/null
. "$GITCCP_DIR/shflags"

# configure shflags
DEFINE_boolean 'assume_yes' false 'Automatic yes to prompts' 'y'
DEFINE_string 'remote_name' 'upstream' 'Remote name' 'r'

# run shflags
FLAGS "$@" || exit $?
eval set -- "${FLAGS_ARGV}"

REMOTE_NAME=${FLAGS_remote_name} 

git fetch "$REMOTE_NAME"

commits=$(git --no-pager log --reverse --pretty=format:"%H" "$REMOTE_NAME"/prod.."$REMOTE_NAME"/master)

jumpCommit=""
blockingCommit=""
for commitHash in $commits
do
    parentCommits=$(git cat-file -p "$commitHash" | grep -c "^parent ")

    if [[ "$parentCommits" -gt 1 ]]
    then
	jumpCommit=$commitHash
    else
	blockingCommit=$commitHash
	break
    fi

done

if [[ -n "$jumpCommit" ]]
then
    branchHead=$(git rev-parse "$REMOTE_NAME"/$TARGET_BRANCH)

    if [ "$branchHead" == "$jumpCommit" ]
    then
	echo "Nothing to do. $REMOTE_NAME/$TARGET_BRANCH branch is up to date"
    else
	echo "Updating latest-release-master with $jumpCommit"
	git --no-pager show "$jumpCommit"

	if [ "${FLAGS_assume_yes}" -eq ${FLAGS_TRUE} ]
	then
		REPLY=Y
	else
		read -p "Are you sure [y/N]? "  -r
	fi

	if [[ $REPLY =~ ^[Yy]$ ]]
	then
	    git push "$REMOTE_NAME" "$jumpCommit:$TARGET_BRANCH"
	    echo "$TARGET_BRANCH branch is updated"
	else
	    echo "$TARGET_BRANCH branch is not updated"
	fi
    fi

    echo
else
    echo "Nothing to do. $REMOTE_NAME/$TARGET_BRANCH branch is up to date"
fi

GH_API_REPO="repos/wso2-enterprise/choreo-control-plane"
if [[ -n "$blockingCommit" ]]
then
	pullRequest=$(gh api "$GH_API_REPO"/commits/"$blockingCommit"/pulls -H "Accept: application/vnd.github.groot-preview+json")
	
	status=$(echo $?)
	if [ "$status" -ne 0 ]
	then
		echo -e "Failed to retrieve pull requests containing commit $blockingCommit"
		exit 1
	fi

	pullBody=$(echo "$pullRequest" | jq -r '.[-1].body')
	pullNumber=$(echo "$pullRequest" | jq -r '.[-1].number')
	issueNumber=$(echo "$pullBody" | sed -nr  's/.*https:\/\/github.com\/wso2-enterprise\/choreo-control-plane\/issues\/([[:digit:]]+).*/\1/p')

	if [[ -z "$issueNumber" || "$issueNumber" == "null" ]]
	then
		issueNumber=$(echo "$pullBody" | sed -nr  's/.*#([[:digit:]]+).*/\1/p')
	fi

	if [[ -n "$issueNumber" && "$issueNumber" != "null" ]]
	then
		response=$(gh api "$GH_API_REPO"/issues/"$issueNumber")
		status=$(echo $?)
		if [ "$status" -eq 0 ]
		then
			response=$(echo -n '{"labels":["MainlineProgressBlockingIssue"]}' | gh api "$GH_API_REPO"/issues/"$issueNumber"/labels --input -)
			status=$(echo $?)
			if [ "$status" -eq 0 ]
			then
				echo "Added label 'MainlineProgressBlockingIssue' to issue #$issueNumber"
			else
				echo -e "Failed to add label 'MainlineProgressBlockingIssue' to issue #$issueNumber\n$response"
			fi
		else
			echo "Issue does not exist with number $issueNumber\n$response"
		fi
	else
		echo -e "Failed to find the issue number in pullrequest #$pullNumber's body:\n$pullBody"
	fi
else
	echo "No blockers."
fi

echo
