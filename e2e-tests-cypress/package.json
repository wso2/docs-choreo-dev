{
  "name": "e2e-tests-cypress",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "dependencies": {
    "cypress-real-events": "^1.10.3",
    "typescript": "^5.3.3",
    "webpack": "^5.68.0"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.12.44",
    "@neuralegion/cypress-har-generator": "^5.16.4",
    "cypress": "^13.8.0",
    "cypress-fail-fast": "^7.0.0"
  },
  "scripts": {
    "pretest": "npm run clean:reports",
    "e2etest:headless": "npx cypress run --headless",
    "devportal-e2etest:headless": "npx cypress run --headless --spec 'cypress/e2e-stable/devportal/*.ts'",
    "console-e2etest:headless": "npx cypress run --headless --spec 'cypress/e2e-stable/console/**/*'",
    "test": "npm run devportal-e2etest:headless || npm run console-e2etest:headless || npm run posttest",
    "local": "npm run e2etest:headless || npm run posttest",
    "e2etest:pdp": "npx cypress run -C cypress.pdp.json ",
    "cy:coverage": "nyc report --reporter=text-summary --reporter=lcov",
    "cy:run": "cypress run",
    "cy:parallel": "parallel -s cy:run -t 4 -d 'cypress/e2e-stable/console/**/*'"
  },
  "author": "",
  "license": "ISC"
}
