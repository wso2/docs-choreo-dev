{
  "name": "e2e-tests-cypress",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "dependencies": {
    "cypress": "^9.4.1",
    "typescript": "^4.4.2"
  },
  "devDependencies": {
    "@testing-library/cypress": "^8.0.1",
    "cypress-file-upload": "^5.0.8",
    "cypress-xpath": "^1.6.2"
  },
  "scripts": {
    "pretest": "npm run clean:reports",
    "e2etest:headless": "npx cypress run --headless",
    "devportal-e2etest:headless": "npx cypress run --headless --spec 'cypress/e2e-smoke/devportal/*.ts'",
    "console-e2etest:headless": "npx cypress run --headless --spec 'cypress/e2e-smoke/console/**/*'",
    "console-prod-periodic-e2etest:headless": "npx cypress run --headless --spec 'cypress/e2e-smoke/console/**/*' --config-file prod-periodic.json",
    "test": "npm run devportal-e2etest:headless || npm run console-e2etest:headless || npm run posttest",
    "local": "npm run e2etest:headless || npm run posttest"
  },
  "author": "",
  "license": "ISC"
}
