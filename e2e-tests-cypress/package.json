{
  "name": "integration-tests-cypress",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "dependencies": {
    "cypress": "^7.1.0",
    "cypress-social-logins": "^1.11.2",
    "typescript": "^4.2.4"
  },
  "devDependencies": {
    "cypress-file-upload": "^5.0.7",
    "cypress-multi-reporters": "^1.5.0",
    "mocha": "^8.3.2",
    "mochawesome": "^6.2.2",
    "mochawesome-merge": "^4.2.0",
    "mochawesome-report-generator": "^5.2.0",
    "@testing-library/cypress": "^7.0.6"
  },
  "scripts": {
    "clean:reports": "rm -R -f cypress/reports && mkdir cypress/reports && mkdir cypress/reports/mochareports",
    "pretest": "npm run clean:reports",
    "devportal-e2etest:headless": "npx cypress run --headless --spec cypress/integration/devportal/*.ts",
    "console-e2etest:headless": "npx cypress run --headless --spec 'cypress/integration/console/**/*'",
    "combine-reports": "mochawesome-merge cypress/reports/mocha/*.json > cypress/reports/mochareports/report.json",
    "generate-report": "marge cypress/reports/mochareports/report.json -f report -o cypress/reports/mochareports",
    "posttest": "npm run combine-reports && npm run generate-report",
    "test": "npm run devportal-e2etest:headless || npm run console-e2etest:headless || npm run posttest"
  },
  "author": "",
  "license": "ISC"
}
