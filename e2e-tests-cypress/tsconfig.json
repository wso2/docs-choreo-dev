{

  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "declaration": true,
    "lib": [
      "ES6",
      "dom"
    ],
    "target": "ES6",
    "types": [
      "cypress",
      "node",
      "cypress-file-upload",
      "cypress-real-events"
    ],
  },
  "include": [
    "**/*.ts"
, "cypress/plugins/index.js"  ]
}
