{
  "cardsV2": [
    {
      "card": {
        "header": {
          "title": "[Urgent] Found Expiring Entra Apps",
          "imageUrl": "https://img.icons8.com/ios-glyphs/30/FA5252/error--v1.png",
          "imageType": "SQUARE"
        },
        "sections": [
          {
            "header": "Summary",
            "collapsible": false,
            "uncollapsibleWidgetsCount": 1,
            "widgets": [
              {
                "decoratedText": {
                  "icon": {
                    "iconUrl": "https://img.icons8.com/ios-filled/50/FAB005/coming-soon.png"
                  },
                  "text": "$EXPIRING_ENTRA_APPS_COUNT Entra Apps Expiring Within a Month"
                }
              },
              {
                "decoratedText": {
                  "icon": {
                    "iconUrl": "https://img.icons8.com/ios-glyphs/30/FA5252/expired.png"
                  },
                  "text": "$EXPIRED_ENTRA_APPS_COUNT Entra Apps Have Already Expired!"
                }
              },
              {
                "buttonList": {
                  "buttons": [
                    {
                      "text": "Click here to get more details",
                      "icon": {
                        "knownIcon": "DESCRIPTION",
                        "altText": "pipeline run"
                      },
                      "onClick": {
                        "openLink": {
                          "url": "$BUILD_URL"
                        }
                      }
                    },
                    {
                      "text": "Click here to exclude apps from the report",
                      "icon": {
                        "knownIcon": "BOOKMARK",
                        "altText": "file containing excluded apps"
                      },
                      "onClick": {
                        "openLink": {
                          "url": "$EXCLUDED_FILE_PATH"
                        }
                      }
                    },
                    {
                      "text": "Click here to find Entra App usages (You'll need Cloud Application Administrator role)",
                      "icon": {
                        "knownIcon": "BOOKMARK",
                        "altText": "Entra app usage insights"
                      },
                      "onClick": {
                        "openLink": {
                          "url": "$ENTRA_APP_USAGE_URL"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
