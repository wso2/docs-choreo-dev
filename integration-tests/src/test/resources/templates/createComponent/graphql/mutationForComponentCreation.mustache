mutation{ createComponent(
      component: {
        name: "{{name}}",
        orgId: {{orgId}},
        orgHandler: "{{orgHandler}}",
        displayName: "{{displayName}}",
        displayType: "{{displayType}}",
        projectId: "{{projectId}}",
        labels: "",
        version: "1.0.0",
        description: "",
        apiId: "",
        ballerinaVersion: "swan-lake-alpha5",
        triggerChannels: "",
        triggerID: null,
        httpBase: true,
        sampleTemplate: "",

      }){
        id, orgId, projectId, handler
      }}