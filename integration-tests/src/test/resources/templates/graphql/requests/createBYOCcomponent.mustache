mutation {
    createByocComponent(
                component: {
                        name: "{{name}}",
                        displayName: "{{name}}",
                        description: "",
                        orgId: {{orgId}},
                        orgHandler: "{{orgHandler}}",
                        projectId: "{{projectId}}",
                        labels: "",
                        componentType: "byocRestApi",
                        port: 80,
                        oasFilePath: "",
                        accessibility: "external",
                        byocConfig: {
                        dockerfilePath: "{{dockerfilePath}}",
                        dockerContext:".",
                        srcGitRepoUrl:"{{srcGitRepoUrl}}",
                        srcGitRepoBranch: "main"
                        }
                }
    )
{
        id,
        createdAt,
        updatedAt,
        name,
        handle,
        organizationId,
        projectId,
        orgHandle,
        type,
        description,
        imageRegistryId,
        imageRegistry {
        id,
        createdAt,
        updatedAt,
        cloudConnectorId,
        imageRepositoryName
        },
        componentType,
        httpBased
    }
}