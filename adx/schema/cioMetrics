.create table deployments (
    timestamp: datetime,
    orgId: string,
    projectId: string,
    componentID: string,
    versionID: string,
    status: string,
    count: int
);

.create table deployments ingestion json mapping "deploymentMapping"
    '['
    '    { "column" : "timestamp", "Properties":{"Path":"$.deploymentTime"}},'
    '    { "column" : "orgId", "Properties":{"Path":"$.organizationID"}},'
    '    { "column" : "projectId", "Properties":{"Path":"$.projectID"}},'
    '    { "column" : "componentID", "Properties":{"Path":"$.componentID"}},'
    '    { "column" : "versionID", "Properties":{"Path":"$.versionID"}},'
    '    { "column" : "status", "Properties":{"Path":"$.status"}},'
    '    { "column" : "count", "Properties":{"Path":"$.deploymentCount"}}'
    ']';
