.create table OrgStats (
    timestamp: datetime,
    orgId: string,
    developerCount: int,
    componentCount: int,
    projectCount: int,
    proxyCount: int,
    serviceCount: int,
    taskCount: int,
    integrationCount: int,
    webAppsCount: int,
    properties: string
);

.create table OrgStats ingestion json mapping "OrgStatsMapping"
    '['
    '    { "column" : "timestamp", "Properties":{"Path":"$.createdTime"}},'
    '    { "column" : "orgId", "Properties":{"Path":"$.organizationId"}},'
    '    { "column" : "developerCount", "Properties":{"Path":"$.developerCount"}},'
    '    { "column" : "componentCount", "Properties":{"Path":"$.componentCount"}},'
    '    { "column" : "projectCount", "Properties":{"Path":"$.projectCount"}},'
    '    { "column" : "proxyCount", "Properties":{"Path":"$.proxyCount"}},'
    '    { "column" : "serviceCount", "Properties":{"Path":"$.serviceCount"}},'
    '    { "column" : "taskCount", "Properties":{"Path":"$.taskCount"}},'
    '    { "column" : "integrationCount", "Properties":{"Path":"$.integrationCount"}},'
    '    { "column" : "webAppsCount", "Properties":{"Path":"$.webAppsCount"}},'
    '    { "column" : "properties", "Properties":{"Path":"$.properties"}}'
    ']';
