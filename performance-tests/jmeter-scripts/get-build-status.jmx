                <stringProp name="script">import org.apache.commons.io.FileUtils
import java.text.SimpleDateFormat;
// Get total number of matches. (Returns string)
def compId = vars.get(&quot;componentId&quot;)
def orgUUID = vars.get(&quot;orgUuid&quot;)
def prjId = vars.get(&quot;projectId&quot;)
log.warn &apos;Output to jmeter console&apos; +  compId
// Create file Object
f = new File(&quot;orgs.csv&quot;)
FileUtils.writeStringToFile(f, orgUUID+ &quot;,&quot; + prjId + &quot;,&quot; + compId + System.getProperty(&quot;line.separator&quot;),true)</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
              <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Constant Timer" enabled="true">
                <stringProp name="ConstantTimer.delay">${commonDelay}</stringProp>
              </ConstantTimer>
              <hashTree/>
            </hashTree>
          </hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">Bearer ${token}</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Fetch env-templates">
            <stringProp name="TestPlan.comments">https://apis.st.choreo.dev/
</stringProp>
            <intProp name="HTTPSampler.concurrentPool">6</intProp>
            <stringProp name="HTTPSampler.domain">${choreoHost}</stringProp>
            <stringProp name="HTTPSampler.protocol">https</stringProp>
            <stringProp name="HTTPSampler.path">/devops/1.0.0/api/v1/organizations/${orgId}/environment-templates</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="EnvTemplate Extractor" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">devEnvTemplate</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.data[?(@.env_name==&apos;Development&apos;)].id</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers"></stringProp>
              <stringProp name="Scope.variable">componentid</stringProp>
            </JSONPostProcessor>
            <hashTree/>
          </hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Project List">
            <intProp name="HTTPSampler.concurrentPool">6</intProp>
            <stringProp name="HTTPSampler.domain">${choreoHost}</stringProp>
            <stringProp name="HTTPSampler.protocol">https</stringProp>
            <stringProp name="HTTPSampler.path">/projects/1.0.0/graphql</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;query&quot;:&quot;query{projects(orgId: ${orgId}){\n      id, orgId, name, version, createdDate, handler, region, description,\n      deploymentPipelineId, type, gitProvider, gitOrganization, repository, branch,secretRef\n    }}&quot;}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Default ProjectId Extractor" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">defaultProjectId</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.data.projects[?(@.name == &apos;Default Project&apos;)].id</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers"></stringProp>
              <stringProp name="Scope.variable">componentid</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Backend ProjectId Extractor" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">backendProjectId</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.data.projects[?(@.name == &apos;backend&apos;)].id</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers"></stringProp>
              <stringProp name="Scope.variable">componentid</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="ProjectId Setter" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def backendProjectId = vars.get(&quot;backendProjectId&quot;);
vars.put(&quot;projectId&quot;, backendProjectId);</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Fetch APIs If">
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
            <stringProp name="IfController.condition">${__jexl3(&quot;${projectId}&quot; != &quot;&quot;)}</stringProp>
          </IfController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Fetch APIs">
              <intProp name="HTTPSampler.concurrentPool">6</intProp>
              <stringProp name="HTTPSampler.domain">${choreoHost}</stringProp>
              <stringProp name="HTTPSampler.protocol">https</stringProp>
              <stringProp name="HTTPSampler.path">/projects/1.0.0/graphql</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">{&quot;query&quot;:&quot;query{ components(orgHandler: \&quot;${orgHandle}\&quot;, projectId: \&quot;${projectId}\&quot;){\n          projectId, \n          id, \n          description,\n          status,\n          name, \n          handler, \n          displayName, \n          displayType, \n          version, \n          createdAt, \n          lastBuildDate,\n          orgHandler,\n          repository {\n              buildpackConfig {\n                  versionId,\n                  buildContext,\n                  languageVersion,\n                  buildpack {\n                      id,\n                      language\n                  }\n              }\n          },\n          apiVersions { \n            apiVersion,\n            proxyName,\n            proxyUrl,\n            proxyId,\n            id,\n            state,\n            latest,\n            branch,\n            accessibility\n          }\n          deploymentTracks{\n            id,\n            createdAt,\n            updatedAt,\n            apiVersion,\n            branch,\n            description,\n            componentId,\n            latest,\n            versionStrategy\n          }\n        } \n      }&quot;}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="ID Extractor" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">componentId</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.data.components[?(@.name==&apos;api-test-go&apos;)].id</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers"></stringProp>
                <stringProp name="Scope.variable">componentid</stringProp>
              </JSONPostProcessor>
              <hashTree/>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Handle Extractor" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">componentHandle</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.data.components[?(@.name==&apos;api-test-go&apos;)].handler</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers"></stringProp>
                <stringProp name="Scope.variable">componentid</stringProp>
              </JSONPostProcessor>
              <hashTree/>
              <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Constant Timer" enabled="true">
                <stringProp name="ConstantTimer.delay">${commonDelay}</stringProp>
              </ConstantTimer>
              <hashTree/>
            </hashTree>
          </hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Go API - Load">
            <intProp name="HTTPSampler.concurrentPool">6</intProp>
            <stringProp name="HTTPSampler.domain">${choreoHost}</stringProp>
            <stringProp name="HTTPSampler.protocol">https</stringProp>
            <stringProp name="HTTPSampler.path">/projects/1.0.0/graphql</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;query&quot;:&quot;query{\n      component(\n        projectId: \&quot;${projectId}\&quot;\n        componentHandler: \&quot;${componentHandle}\&quot;\n      ){\n        id,\n        name,\n        handler,\n        description,\n        displayType,\n        displayName,\n        ownerName,\n        orgId,\n        orgHandler,\n        version,\n        labels,\n        createdAt,\n        projectId,\n        apiId,\n        httpBased,\n        isMigrationCompleted,\n        skipDeploy,\n        isUnifiedConfigMapping,\n        apiVersions{\n          apiVersion,\n          proxyName,\n          proxyUrl,\n          proxyId,\n          id,\n          state,\n          latest,\n          branch,\n          accessibility,\n          appEnvVersions{\n            environmentId,\n            releaseId,\n            release{\n              id,\n              metadata{\n                choreoEnv\n              },\n              environmentId,\n              environment,\n              gitHash,\n              gitOpsHash,\n            }\n          }\n        },\n        deploymentTracks{\n          id,\n          createdAt,\n          updatedAt,\n          apiVersion,\n          branch,\n          description,\n          componentId,\n          latest,\n          versionStrategy\n        }\n      }\n    }&quot;}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
