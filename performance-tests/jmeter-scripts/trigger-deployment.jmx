vars.put(&quot;buildStatus&quot;, &quot;&quot;);
vars.put(&quot;buildConclusion&quot;, &quot;&quot;);
vars.put(&quot;publicUrl&quot;, &quot;&quot;);
vars.put(&quot;endpointState&quot;, &quot;&quot;);
vars.put(&quot;deployState&quot;, &quot;&quot;);

vars.put(&quot;webAppPercentage&quot;, &quot;0&quot;);
vars.put(&quot;webAppBuildConclusion&quot;, &quot;&quot;);
vars.put(&quot;webAppId&quot;, &quot;&quot;);
vars.put(&quot;webAppHandle&quot;, &quot;&quot;);
vars.put(&quot;webAppVersionId&quot;, &quot;&quot;);
vars.put(&quot;webAppReleaseId&quot;, &quot;&quot;);
vars.put(&quot;webAppBuildStatus&quot;, &quot;&quot;);

</stringProp>
