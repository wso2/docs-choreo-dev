          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def prefix = vars.get(&quot;usernamePrefix&quot;);
def counter = vars.get(&quot;tenantCounter&quot;);

vars.put(&quot;username&quot;, prefix + counter);
