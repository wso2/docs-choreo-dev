vars.put(&quot;buildStatus&quot;, &quot;&quot;);
vars.put(&quot;buildConclusion&quot;, &quot;&quot;);
vars.put(&quot;publicUrl&quot;, &quot;&quot;);
vars.put(&quot;endpointState&quot;, &quot;&quot;);
vars.put(&quot;deployState&quot;, &quot;&quot;);
vars.put(&quot;status&quot;, &quot;&quot;);

</stringProp>
        </JSR223Sampler>
