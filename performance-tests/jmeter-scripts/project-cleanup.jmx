        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Set Username" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def prefix = vars.get(&quot;usernamePrefix&quot;);
def counter = vars.get(&quot;tenantCounter&quot;);

vars.put(&quot;username&quot;, prefix + counter);
</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Skip Test For" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">String filepath = vars.get(&quot;failedUsers&quot;);

if(filepath != null &amp;&amp; !filepath.isEmpty()) {
	filepath = filepath.strip();
}

if (vars.getObject(&quot;SKIP_USERNAMES&quot;) == null) {
  File file = new File(filepath);
  if (file.exists()) {
      List&lt;String&gt; usernames = file.readLines();
      vars.putObject(&quot;SKIP_USERNAMES&quot;, usernames);
  } else {
		log.info(&quot;*****File doesn&apos;t exist &quot;);
  	}
}
List&lt;String&gt; skipUsernames = vars.getObject(&quot;SKIP_USERNAMES&quot;);

// Get the current username from a JMeter variable
if (skipUsernames != null) {
  String currentUser = vars.get(&quot;username&quot;);

  // Check if the current username is in the skip list
  if (skipUsernames.contains(currentUser)) {
      // Log info and go to next iteration
      log.info(&quot;Skipping execution for user: &quot; + currentUser);
      vars.put(&quot;SKIP_THIS_ITERATION&quot;, &quot;true&quot;);
  } else {
      vars.put(&quot;SKIP_THIS_ITERATION&quot;, &quot;false&quot;);
  }
}</stringProp>
        </JSR223Sampler>
