log.warn &apos;Output to jmeter console&apos; +  compId
// Create file Object
f = new File(&quot;orgs.csv&quot;)
FileUtils.writeStringToFile(f, orgUUID+ &quot;,&quot; + prjId + &quot;,&quot; + compId + System.getProperty(&quot;line.separator&quot;),true)</stringProp>
